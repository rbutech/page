    {
      "id": "p_mvmttdkm_eja10n",
      "name": "welcome",
      "slug": "welcome",
      "title": "welcome",
      "heading": "welcome",
      "body": "\n<section id=\"future-mindmap\" style=\"max-width:900px;margin:36px auto;padding:28px 16px;text-align:center;font-family:Arial,sans-serif;color:#172033;\">\n  <h2 style=\"font-size:28px;margin-bottom:8px;\">One Community. Many Possibilities.</h2>\n  <p style=\"color:#64748b;margin-bottom:24px;\">A simple map of how we learn, create, share and grow.</p>\n\n  <div style=\"max-width:700px;margin:auto;\">\n    <svg viewBox=\"0 0 700 390\" role=\"img\"\n         aria-label=\"Mind map connecting Learn, Build, Share and Connect to Build the Future\"\n         style=\"width:100%;height:auto;display:block;\">\n\n      <!-- Connecting lines -->\n      <g fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"3\" stroke-linecap=\"round\">\n        <path d=\"M350 195 L170 95\"/>\n        <path d=\"M350 195 L530 95\"/>\n        <path d=\"M350 195 L170 295\"/>\n        <path d=\"M350 195 L530 295\"/>\n      </g>\n\n      <!-- Central idea -->\n      <rect x=\"245\" y=\"150\" width=\"210\" height=\"90\" rx=\"22\"\n            fill=\"#172554\"/>\n      <text x=\"350\" y=\"188\" text-anchor=\"middle\"\n            fill=\"#ffffff\" font-size=\"20\" font-weight=\"bold\">Build the</text>\n      <text x=\"350\" y=\"215\" text-anchor=\"middle\"\n            fill=\"#93c5fd\" font-size=\"22\" font-weight=\"bold\">Future</text>\n\n      <!-- Learn -->\n      <rect x=\"75\" y=\"55\" width=\"190\" height=\"80\" rx=\"18\"\n            fill=\"#dbeafe\" stroke=\"#60a5fa\" stroke-width=\"2\"/>\n      <text x=\"170\" y=\"89\" text-anchor=\"middle\"\n            fill=\"#1d4ed8\" font-size=\"19\" font-weight=\"bold\">Learn</text>\n      <text x=\"170\" y=\"112\" text-anchor=\"middle\"\n            fill=\"#334155\" font-size=\"13\">Explore new ideas</text>\n\n      <!-- Build -->\n      <rect x=\"435\" y=\"55\" width=\"190\" height=\"80\" rx=\"18\"\n            fill=\"#dcfce7\" stroke=\"#4ade80\" stroke-width=\"2\"/>\n      <text x=\"530\" y=\"89\" text-anchor=\"middle\"\n            fill=\"#166534\" font-size=\"19\" font-weight=\"bold\">Build</text>\n      <text x=\"530\" y=\"112\" text-anchor=\"middle\"\n            fill=\"#334155\" font-size=\"13\">Create real projects</text>\n\n      <!-- Share -->\n      <rect x=\"75\" y=\"255\" width=\"190\" height=\"80\" rx=\"18\"\n            fill=\"#fef3c7\" stroke=\"#fbbf24\" stroke-width=\"2\"/>\n      <text x=\"170\" y=\"289\" text-anchor=\"middle\"\n            fill=\"#92400e\" font-size=\"19\" font-weight=\"bold\">Share</text>\n      <text x=\"170\" y=\"312\" text-anchor=\"middle\"\n            fill=\"#334155\" font-size=\"13\">Spread knowledge</text>\n\n      <!-- Connect -->\n      <rect x=\"435\" y=\"255\" width=\"190\" height=\"80\" rx=\"18\"\n            fill=\"#f3e8ff\" stroke=\"#c084fc\" stroke-width=\"2\"/>\n      <text x=\"530\" y=\"289\" text-anchor=\"middle\"\n            fill=\"#6b21a8\" font-size=\"19\" font-weight=\"bold\">Connect</text>\n      <text x=\"530\" y=\"312\" text-anchor=\"middle\"\n            fill=\"#334155\" font-size=\"13\">Grow together</text>\n    </svg>\n  </div>\n\n  <p style=\"font-size:17px;line-height:1.7;max-width:600px;margin:20px auto 0;\">\n    Every skill shared, every project built, and every connection made\n    brings us closer to a smarter, more creative future.\n  </p>\n</section>\n",
      "parentId": "home"
    }
  ]
